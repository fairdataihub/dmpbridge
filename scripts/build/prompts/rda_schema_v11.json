{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RDA maDMP form - simplified output constraint (v11)",
  "description": "The fields of the prompt's JSON form only, with the containers the references score made mandatory (dataset, distribution, metadata) and the parts a plan may genuinely lack (host, license, standard, project) optional. Replaces the full maDMP 1.2 schema as Ollama's output constraint; the full schema made every unrequired part skippable, and the smaller models skipped them.",
  "type": "object",
  "required": ["dmp"],
  "additionalProperties": false,
  "properties": {
    "dmp": {
      "type": "object",
      "required": ["title", "created", "modified", "language", "ethical_issues_exist", "dmp_id", "contact", "dataset"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "created": {"type": "string"},
        "modified": {"type": "string"},
        "language": {"type": "string"},
        "ethical_issues_exist": {"type": "string", "enum": ["yes", "no", "unknown"]},
        "dmp_id": {
          "type": "object",
          "required": ["identifier", "type"],
          "additionalProperties": false,
          "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
        },
        "contact": {
          "type": "object",
          "required": ["name", "mbox", "contact_id"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "mbox": {"type": "string"},
            "contact_id": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["identifier", "type"],
                "additionalProperties": false,
                "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
              }
            }
          }
        },
        "dataset": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "description", "type", "personal_data", "sensitive_data", "dataset_id", "distribution", "metadata"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "description": {"type": "string"},
              "type": {"type": "string"},
              "personal_data": {"type": "string", "enum": ["yes", "no", "unknown"]},
              "sensitive_data": {"type": "string", "enum": ["yes", "no", "unknown"]},
              "dataset_id": {
                "type": "object",
                "required": ["identifier", "type"],
                "additionalProperties": false,
                "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
              },
              "distribution": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["title", "data_access", "license"],
                  "additionalProperties": false,
                  "properties": {
                    "title": {"type": "string"},
                    "data_access": {"type": "string", "enum": ["open", "shared", "closed"]},
                    "host": {
                      "type": "object",
                      "required": ["title"],
                      "additionalProperties": false,
                      "properties": {"title": {"type": "string"}, "url": {"type": "string"}}
                    },
                    "license": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["license_ref", "start_date"],
                        "additionalProperties": false,
                        "properties": {"license_ref": {"type": "string"}, "start_date": {"type": "string"}}
                      }
                    }
                  }
                }
              },
              "metadata": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["description", "language", "metadata_standard_id"],
                  "additionalProperties": false,
                  "properties": {
                    "description": {"type": "string"},
                    "language": {"type": "string"},
                    "metadata_standard_id": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["identifier", "type"],
                        "additionalProperties": false,
                        "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "project": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "description"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "description": {"type": "string"},
              "funding": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["funder_id", "funding_status"],
                  "additionalProperties": false,
                  "properties": {
                    "funder_id": {
                      "type": "object",
                      "required": ["identifier", "type"],
                      "additionalProperties": false,
                      "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
                    },
                    "funding_status": {"type": "string", "enum": ["planned", "applied", "granted", "rejected"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
