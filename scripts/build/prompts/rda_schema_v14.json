{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RDA maDMP form - output constraint aligned with the [REQUIRED] / [RECOMMENDED] template (v14)",
  "description": "v13's simplified constraint, with every field the template marks [REQUIRED] forced: host_id required whenever a host is written, project compulsory with title and description, funder_id and funding_status required inside funding. The [RECOMMENDED] fields (descriptions, byte_size, issued, grant_id, project start and end) are present as optional. dataset, distribution and metadata stay compulsory (at least one each); dataset and metadata descriptions stay required as in v13.",
  "type": "object",
  "required": ["dmp"],
  "additionalProperties": false,
  "properties": {
    "dmp": {
      "type": "object",
      "required": ["title", "created", "modified", "language", "ethical_issues_exist", "dmp_id", "contact", "dataset", "project"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "created": {"type": "string"},
        "modified": {"type": "string"},
        "language": {"type": "string"},
        "ethical_issues_exist": {"type": "string", "enum": ["yes", "no", "unknown"]},
        "dmp_id": {
          "type": "object",
          "required": ["identifier", "type"],
          "additionalProperties": false,
          "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
        },
        "contact": {
          "type": "object",
          "required": ["name", "mbox", "contact_id"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "mbox": {"type": "string"},
            "contact_id": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["identifier", "type"],
                "additionalProperties": false,
                "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
              }
            }
          }
        },
        "dataset": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "description", "type", "personal_data", "sensitive_data", "dataset_id", "distribution", "metadata"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "description": {"type": "string"},
              "type": {"type": "string"},
              "personal_data": {"type": "string", "enum": ["yes", "no", "unknown"]},
              "sensitive_data": {"type": "string", "enum": ["yes", "no", "unknown"]},
              "dataset_id": {
                "type": "object",
                "required": ["identifier", "type"],
                "additionalProperties": false,
                "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
              },
              "distribution": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["title", "data_access", "license"],
                  "additionalProperties": false,
                  "properties": {
                    "title": {"type": "string"},
                    "data_access": {"type": "string", "enum": ["open", "shared", "closed"]},
                    "description": {"type": "string"},
                    "byte_size": {"type": "integer"},
                    "issued": {"type": "string"},
                    "host": {
                      "type": "object",
                      "required": ["title", "host_id"],
                      "additionalProperties": false,
                      "properties": {
                        "title": {"type": "string"},
                        "url": {"type": "string"},
                        "host_id": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": ["identifier", "type"],
                            "additionalProperties": false,
                            "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
                          }
                        }
                      }
                    },
                    "license": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["license_ref", "start_date"],
                        "additionalProperties": false,
                        "properties": {"license_ref": {"type": "string"}, "start_date": {"type": "string"}}
                      }
                    }
                  }
                }
              },
              "metadata": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["description", "language", "metadata_standard_id"],
                  "additionalProperties": false,
                  "properties": {
                    "description": {"type": "string"},
                    "language": {"type": "string"},
                    "metadata_standard_id": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["identifier", "type"],
                        "additionalProperties": false,
                        "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "project": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "description"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "description": {"type": "string"},
              "start": {"type": "string"},
              "end": {"type": "string"},
              "funding": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["funder_id", "funding_status"],
                  "additionalProperties": false,
                  "properties": {
                    "funder_id": {
                      "type": "object",
                      "required": ["identifier", "type"],
                      "additionalProperties": false,
                      "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
                    },
                    "funding_status": {"type": "string", "enum": ["planned", "applied", "granted", "rejected"]},
                    "grant_id": {
                      "type": "object",
                      "required": ["identifier", "type"],
                      "additionalProperties": false,
                      "properties": {"identifier": {"type": "string"}, "type": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
