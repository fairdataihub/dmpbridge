    "template": {
      "id": 1,
      "title": null,
      "description": null,
      "version": null,
      "section": [
        {
          "id": 1,
          "title": "1. Types of data",
          "description": null,
          "order": 1,
          "question": [
            {
              "id": 1,
              "text": "1. Types of data",
              "order": 1,
              "answer": {
                "id": 1,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The bulk of the data generated in this project will be 1, 2, 3, and 4\ndimensional arrays of numbers and bytes representing fluid state variables generated via\ncomputer simulations of fluid flow. Images and video files will be created from the fluid\ndata using both commercial packages, such as Matlab and free visualization packages\nsuch as VAPOR (developed at NCAR)."
                }
              }
            }
          ]
        },
        {
          "id": 2,
          "title": "2. Data and metadata standards",
          "description": null,
          "order": 2,
          "question": [
            {
              "id": 2,
              "text": "2. Data and metadata standards",
              "order": 1,
              "answer": {
                "id": 2,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The PI’s research group will adopt the longstanding\npractice that all generated data should be straightforwardly reproducible. Thus, codes are\nstored within the same directory on a mass storage system along with the data they\ngenerate. “Readme” files will also be provided for explanation of the directory content."
                }
              }
            }
          ]
        },
        {
          "id": 3,
          "title": "3. Policies for access and sharing",
          "description": null,
          "order": 3,
          "question": [
            {
              "id": 3,
              "text": "3. Policies for access and sharing",
              "order": 1,
              "answer": {
                "id": 3,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Interested parties will be able to request data and codes at\nthe end of the project. Such parties will be responsible for their own version control and\nexecution."
                }
              }
            }
          ]
        },
        {
          "id": 4,
          "title": "4. Policies and provisions for re-use, re-distribution",
          "description": null,
          "order": 4,
          "question": [
            {
              "id": 4,
              "text": "4. Policies and provisions for re-use, re-distribution",
              "order": 1,
              "answer": {
                "id": 4,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Simulation data will in essence grow to\nseveral terrabytes with an associated cost of storage. Data will be made publicly\navailable upon request at the end of the project. Although open-source, we envisage that\nintellectual rights to the code will be retained by the CU group. Dissemination of open-\nsource software will be released once fully tested and published."
                }
              }
            }
          ]
        },
        {
          "id": 5,
          "title": "5. Plans for archiving and preservation of access",
          "description": null,
          "order": 5,
          "question": [
            {
              "id": 5,
              "text": "5. Plans for archiving and preservation of access",
              "order": 1,
              "answer": {
                "id": 5,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Local data will be archived on the group’s\nmass storage system. As mentioned above, all data generated is archived with the entire\ncode that generated it. Additionally, further backups of the data will be provided by CU’s\nNSF-funded research computing. We imagine the data being of relevance and stored for\n> 10 years."
                }
              }
            }
          ]
        }
      ]
    }
  }
