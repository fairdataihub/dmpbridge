    "title": "CAREER: HIGH-RESOLUTION NMR FOR PARAMAGNETIC SODIUM ELECTRODES",
    "project": [
      {
        "title": "CAREER: HIGH-RESOLUTION NMR FOR PARAMAGNETIC SODIUM ELECTRODES",
        "description": "The project involves synthesizing battery material samples in powder form and characterizing them using various techniques, including electrochemical testing, X-ray diffraction, solid-state NMR spectroscopy, EPR spectroscopy, magnetometry, impedance spectroscopy, X-ray photoelectron and absorption spectroscopy, and Mössbauer spectroscopy. The project also involves developing and extending the Van der Ven group’s CASM software to enable the simulation of finite temperature NMR spectra of paramagnetic materials, and generating educational and outreach materials.",
        "start": "2024-01-01"
      }
