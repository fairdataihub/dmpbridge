  {
    "source_pdf": "sample4.pdf",
    "page": null,
    "line_order": 53,
    "text": "Plans for archiving data, samples, and other research products, and for preservation of access to them.",
    "label": "section",
    "document_format": "docling_markdown",
    "extractor": "docling"
  },
  {
    "source_pdf": "sample4.pdf",
    "page": null,
    "line_order": 54,
    "text": "All data will be stored and archived in our research group's RAID server, which already incorporates data redundancy for backups. It will remain there for at least 5 years after the release of the corresponding publication or project. All data require for the creation of a research manuscript will be stored. Additional data acquired will also be stored for future reference in the research group. Data may be compressed as necessary for data sharing. Metadata files will be stored in appropriate directories to detail what is being stored in the server.",
    "label": "content",
    "document_format": "docling_markdown",
    "extractor": "docling"
