    "template": {
      "id": 1,
      "title": "DATA MANAGEMENT PLAN",
      "description": null,
      "version": null,
      "section": [
        {
          "id": 1,
          "title": "Human Subjects Training and Institutional Review Board (IRB) Approval",
          "description": null,
          "order": 1,
          "question": [
            {
              "id": 1,
              "text": "Training for the P.I. and Research Assistants",
              "order": 1,
              "answer": {
                "id": 1,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The P.I. has completed human subjects training. The research assistants will be required to complete human subjects training through the UCR Office of Research and Economic Development."
                }
              }
            }
          ]
        },
        {
          "id": 2,
          "title": "Data Collection",
          "description": null,
          "order": 2,
          "question": [
            {
              "id": 2,
              "text": "Longevity Analysis",
              "order": 1,
              "answer": {
                "id": 2,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The longevity analysis will collect data on the length of time clusters have operated (including the length of time between first hires and closures for those that have disbanded). We will collect data from a minimum of 36 institutions, attempting to find dates of operation for all clusters authorized at those institutions."
                }
              }
            },
            {
              "id": 3,
              "text": "Comparative Analysis",
              "order": 2,
              "answer": {
                "id": 3,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The comparative analysis will collect data on performance and attitudes from cluster participants. The performance data will include publications, citations, research grants, patents, licenses, and start-ups founded by members of interdisciplinary cluster hires, as well as those of a matched sample of faculty hired through normal departmental mechanisms."
                }
              }
            }
          ]
        },
        {
          "id": 3,
          "title": "Data Management",
          "description": null,
          "order": 3,
          "question": [
            {
              "id": 4,
              "text": "Backup and Preservation",
              "order": 1,
              "answer": {
                "id": 4,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Data will be backed up on a weekly basis on a hard drive kept in a locked cabinet in the project office. The data will be preserved exclusively on the two project computers and the back-up hard drive."
                }
              }
            }
          ]
        },
        {
          "id": 4,
          "title": "Data Sharing",
          "description": null,
          "order": 4,
          "question": [
            {
              "id": 5,
              "text": "Sharing with Other Researchers",
              "order": 1,
              "answer": {
                "id": 5,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Following the completion of the project, the data archive will be made available on the project website to researchers who are interested in pursuing questions related to cluster hiring."
                }
              }
            }
          ]
        },
        {
          "id": 5,
          "title": "Data Security and Confidentiality",
          "description": null,
          "order": 5,
          "question": [
            {
              "id": 6,
              "text": "Access Control",
              "order": 1,
              "answer": {
                "id": 6,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The only individuals with access to the collected data will be the P.I. and research assistants."
                }
              }
            }
          ]
        }
      ]
    }
  }
