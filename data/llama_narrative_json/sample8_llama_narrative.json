  "narrative": {
    "download_url": null,
    "template": {
      "id": 1,
      "title": "Univ. of California, Riverside Data Management Plan",
      "description": null,
      "version": null,
      "section": [
        {
          "id": 1,
          "title": "1. Policy and Practice",
          "description": null,
          "order": 1,
          "question": [
            {
              "id": 1,
              "text": "1. Policy and Practice",
              "order": 1,
              "answer": {
                "id": 1,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The Bourns College of Engineering (BCOE) at the University of California, Riverside , in partnership with the UCR Libraries and the California Digital Library, has established a new, custom data management system designed to make results of our research readily and reliably accessible. This system combines two services of the California Digital Library for the first time: an eScholarship series, a curated site where all BCOE investigators can store and disseminate their data, and EZID permanent identifiers for long-term identification and management of data resources."
                }
              }
            },
            {
              "id": 2,
              "text": "All principal investigators in BCOE are responsible for complying with sponsor policies regarding data management and accessibility. All have sufficient computing resources to store and process the data generated in their research.",
              "order": 2,
              "answer": {
                "id": 2,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Every principal investigator has the ability to create his or her personal web site, and to make data sets available through that web site. Additionally, the eScholarship series (http://escholarship.org/uc/bcoe) provides a ready-made resource for dissemination.\nResearchers can submit materials to the eScholarship series site, where it is automatically given an EZID persistent identifier. All material on the site is indexed on Google, Google Scholar, and Melvyl/WorldCat."
                }
              }
            }
          ]
        },
        {
          "id": 2,
          "title": "2. Scope",
          "description": null,
          "order": 2,
          "question": [
            {
              "id": 3,
              "text": "2. Scope",
              "order": 1,
              "answer": {
                "id": 3,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "This Data Management Plan addresses the NSF policy that primary data “commonly accepted in the scientific community as necessary to validate research findings” be made available at little or no cost to the PI or project."
                }
              }
            },
            {
              "id": 4,
              "text": "Data that must be withheld long enough to enable peer review and publication/dissemination or protection of intellectual property is subject to this plan only after those steps have taken place.",
              "order": 2,
              "answer": {
                "id": 4,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Data will be available for access and sharing as soon as is reasonably possible, and no later than two years after its acquisition. The data will be preserved for at least three years beyond the award period, as required by NSF guidelines."
                }
              }
            }
          ]
        },
        {
          "id": 3,
          "title": "3. Data and Metadata Format and Content",
          "description": null,
          "order": 3,
          "question": [
            {
              "id": 5,
              "text": "3. Data and Metadata Format and Content",
              "order": 1,
              "answer": {
                "id": 5,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The software will be made available in source code form and so will the applications developed. This will allow other researchers to not only use it but also modify it for their use."
                }
              }
            },
            {
              "id": 6,
              "text": "All materials uploaded to the eScholarship site from UCR will be tagged uniformly with metadata about the source and nature of the data.",
              "order": 2,
              "answer": {
                "id": 6,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Any electronic file format (e.g., text, spreadsheets, images) can be accepted. As a service to assure that materials are formatted correctly, a curator from the College reviews all submissions before they are accepted."
                }
              }
            }
          ]
        },
        {
          "id": 4,
          "title": "4. Accessibility and Data Protection",
          "description": null,
          "order": 4,
          "question": [
            {
              "id": 7,
              "text": "4. Accessibility and Data Protection",
              "order": 1,
              "answer": {
                "id": 7,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Materials will be searchable through a number of databases and search engines, including Google and Google Scholar."
                }
              }
            },
            {
              "id": 8,
              "text": "Confidential material will be handled according to policies and protocols for human subjects, FERPA, and any other applicable regulations and restrictions.",
              "order": 2,
              "answer": {
                "id": 8,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Not answered"
                }
              }
            }
          ]
        },
        {
          "id": 5,
          "title": "5. Derivative Products",
          "description": null,
          "order": 5,
          "question": [
            {
              "id": 9,
              "text": "5. Derivative Products",
              "order": 1,
              "answer": {
                "id": 9,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "All materials will contain acknowledgement of NSF support as per NSF policy: “ This material is based upon work supported by the National Science Foundation under Grant No. (NSF grant number). ”"
                }
              }
            },
            {
              "id": 10,
              "text": "Additionally, materials will contain a disclaimer that “ any opinions, findings, and conclusions or recommendations expressed in this material are those of the author(s) and do not necessarily reflect the views of the National Science Foundation .”",
              "order": 2,
              "answer": {
                "id": 10,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Not answered"
                }
              }
            }
          ]
        },
        {
          "id": 6,
          "title": "6. Archiving and Access",
          "description": null,
          "order": 6,
          "question": [
            {
              "id": 11,
              "text": "6. Archiving and Access",
              "order": 1,
              "answer": {
                "id": 11,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "If the PI leaves UCR, the products in the eScholarship series will remain stored there."
                }
              }
            }
          ]
        }
      ]
    }
  }
