    "template": {
      "id": 1,
      "title": "Resource/Data Sharing Plan",
      "description": null,
      "version": null,
      "section": [
        {
          "id": 1,
          "title": "The study investigators are committed to the open and timely dissemination of study data.",
          "description": null,
          "order": 1,
          "question": [
            {
              "id": 1,
              "text": "The study investigators are committed to the open and timely dissemination of study data.",
              "order": 1,
              "answer": {
                "id": 1,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "The final datasets will include demographic and clinical assessment data obtained from interviews, questionnaires, and behavioral tasks collected from human subjects."
                }
              }
            }
          ]
        },
        {
          "id": 2,
          "title": "The investigators will be fully compliant to the NIMH Data Archive (NDA) Data Sharing Terms and Conditions,",
          "description": null,
          "order": 2,
          "question": [
            {
              "id": 2,
              "text": "The investigators will be fully compliant to the NIMH Data Archive (NDA) Data Sharing Terms and Conditions,",
              "order": 1,
              "answer": {
                "id": 2,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "including submitting and harmonizing all descriptive/raw data and analyzed data at the item and subject-level to the National Database for Clinical Trials (NDCT) according to the expected timeline (semi-annually, at the end of the grant or at the time of publication, whichever occurs first).\nThe investigators will include appropriate language in participant consent documents to allow for the data sharing through NDA,\nand complete all required paperwork related to the submission and sharing."
                }
              }
            }
          ]
        },
        {
          "id": 3,
          "title": "The investigators will certify the quality of all data prior to submission",
          "description": null,
          "order": 3,
          "question": [
            {
              "id": 3,
              "text": "The investigators will certify the quality of all data prior to submission",
              "order": 1,
              "answer": {
                "id": 3,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "and review the data for accuracy after submission."
                }
              }
            }
          ]
        },
        {
          "id": 4,
          "title": "The investigators will also associate the submitted data in NDA with the findings/publications (both positive and negative) using NDA-provided features.",
          "description": null,
          "order": 4,
          "question": [
            {
              "id": 4,
              "text": "The investigators will also associate the submitted data in NDA with the findings/publications (both positive and negative) using NDA-provided features.",
              "order": 1,
              "answer": {
                "id": 4,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "All submitted data will include an NDA Global Unique Identifier (GUID)\nand will not include personally identifiable information (PII)."
                }
              }
            }
          ]
        },
        {
          "id": 5,
          "title": "The exception to the above is the audio recordings of the treatment sessions.",
          "description": null,
          "order": 5,
          "question": [
            {
              "id": 5,
              "text": "The exception to the above is the audio recordings of the treatment sessions.",
              "order": 1,
              "answer": {
                "id": 5,
                "json": {
                  "type": "textArea",
                  "meta": {
                    "schemaVersion": "1.0"
                  },
                  "answer": "Even with the removal of all identifiers,\nwe believe that it would be difficult if not impossible to protect the identities of participants given the voice characteristics of participants will be readily available and the relatively restricted area from which we are recruiting participants.\nTherefore, we are not planning to share this part of the data."
                }
              }
            }
          ]
        }
      ]
    }
